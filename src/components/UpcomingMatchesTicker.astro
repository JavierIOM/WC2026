---
import { matches } from '../data/predictions';
---

<div id="ticker-outer" style="background:var(--color-surface);border-bottom:1px solid var(--color-border);display:flex;align-items:center;gap:1rem;padding:0 1.25rem;">
  <div style="flex-shrink:0;padding:0.75rem 0;color:var(--color-muted);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;font-weight:700;white-space:nowrap;">Upcoming</div>
  <div id="ticker-container" style="flex:1;min-width:0;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;" data-predictions={JSON.stringify(matches)}>
    <div id="matches-list" style="display:flex;gap:0.75rem;padding:0.6rem 0;width:max-content;"></div>
  </div>
</div>

<script is:inline>
  const CONTAINER = document.getElementById('ticker-container');
  const MATCHES_LIST = document.getElementById('matches-list');
  const predictions = JSON.parse(CONTAINER.getAttribute('data-predictions') || '[]');

  const teamNameMap = {
    'United States': 'USA', 'Uruguay': 'Uruguay', 'Iran': 'Iran',
    'New Zealand': 'NZL', 'Saudi Arabia': 'KSA', 'Mexico': 'MEX',
    'South Korea': 'KOR', 'Senegal': 'SEN', 'Spain': 'ESP',
    'Cape Verde': 'CPV', 'Belgium': 'BEL', 'Egypt': 'EGY',
    'Netherlands': 'NED', 'Japan': 'JPN', 'Ivory Coast': 'CIV',
    'Ecuador': 'ECU', 'Germany': 'GER', 'Curaçao': 'CUR',
    'Sweden': 'SWE', 'Tunisia': 'TUN', 'England': 'ENG',
    'Croatia': 'CRO', 'Greece': 'GRE', 'Turkey': 'TUR',
    'Türkiye': 'TUR', 'Australia': 'AUS', 'Argentina': 'ARG',
    'Algeria': 'ALG', 'Morocco': 'MAR', 'Scotland': 'SCO',
    'Brazil': 'BRA', 'Haiti': 'HAI', 'Paraguay': 'PAR',
    'Canada': 'CAN', 'Bosnia and Herzegovina': 'BIH', 'Switzerland': 'SUI',
    'Ghana': 'GHA', 'Panama': 'PAN', 'Uzbekistan': 'UZB',
    'Colombia': 'COL', 'Czechia': 'CZE', 'Czech Republic': 'CZE',
    'South Africa': 'RSA', 'France': 'FRA', 'Norway': 'NOR',
    'Iraq': 'IRQ', 'Austria': 'AUT', 'Jordan': 'JOR',
    'Portugal': 'POR', 'DR Congo': 'DRC', 'Wales': 'WAL',
    'Kazakhstan': 'KAZ', 'Costa Rica': 'CRC',
  };

  function card(home, away, predictionText, scorerText) {
    return `<div style="display:inline-flex;flex-direction:column;gap:0.25rem;padding:0.4rem 0.65rem;background:var(--color-bg);border:1px solid var(--color-border);border-radius:4px;white-space:nowrap;">
      <div style="display:flex;align-items:center;gap:0.35rem;font-size:0.75rem;">
        <span style="font-weight:600;">${home}</span>
        <span style="font-weight:800;color:var(--color-accent);min-width:2rem;text-align:center;">${predictionText}</span>
        <span style="font-weight:600;">${away}</span>
      </div>
      ${scorerText ? `<div style="font-size:0.65rem;color:var(--color-muted);text-align:center;">${scorerText}</div>` : ''}
    </div>`;
  }

  async function fetchAndRender() {
    try {
      const res = await fetch('/.netlify/functions/live-matches');
      const data = await res.json();
      const upcoming = data.matches.upcoming || [];

      if (upcoming.length === 0) {
        renderFallback();
        return;
      }

      MATCHES_LIST.innerHTML = upcoming.slice(0, 12).map(m => {
        const home = m.competitors?.[0];
        const away = m.competitors?.[1];
        if (!home || !away) return '';
        const hc = teamNameMap[home.name] || home.name;
        const ac = teamNameMap[away.name] || away.name;
        const pred = predictions.find(p => p.home === hc && p.away === ac);
        const score = pred?.predHome !== undefined ? `${pred.predHome}-${pred.predAway}` : '?-?';
        const scorer = pred?.scorerCall ? `⚽ ${pred.scorerCall}` : '';
        return card(hc, ac, score, scorer);
      }).join('');

    } catch {
      renderFallback();
    }
  }

  function renderFallback() {
    const upcoming = predictions.filter(m => m.actualHome === undefined && m.predHome !== undefined).slice(0, 12);
    MATCHES_LIST.innerHTML = upcoming.map(m => {
      const score = `${m.predHome}-${m.predAway}`;
      const scorer = m.scorerCall ? `⚽ ${m.scorerCall}` : '';
      return card(m.home, m.away, score, scorer);
    }).join('');
  }

  fetchAndRender();
  setInterval(fetchAndRender, 60000);
</script>

<style>
  #ticker-container::-webkit-scrollbar { height: 3px; }
  #ticker-container::-webkit-scrollbar-track { background: transparent; }
  #ticker-container::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 2px; }
</style>
