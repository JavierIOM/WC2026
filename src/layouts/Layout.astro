---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WC2026 Prediction Tracker',
  description = 'Running World Cup 2026 predictions vs actual results — scoreline calls, scorer picks, and auto-computed accuracy.',
} = Astro.props;

const ogImage = '/og.png';
const siteUrl = 'https://wc26.rockyroo.fish';

// Build a per-page canonical URL so og:url and <link rel="canonical"> are correct
// on /about as well as the homepage, not just hardcoded to the root.
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const buildTime = new Date().toLocaleString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
  hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London', timeZoneName: 'short',
});

const path = Astro.url.pathname;
const onAbout = path.startsWith('/about');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WC2026 — World Cup 2026 prediction tracker" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WC2026 Prediction Tracker" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta property="fb:app_id" content="811269275316635" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Sticky Nav -->
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" aria-label="WC2026 — home">WC2026</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/#method"    class="nav-link">Method</a>
          <a href="/#matchdays" class="nav-link">Matches</a>
          <a href="/#dashboard" class="nav-link">Dashboard</a>
          <a href="/#upcoming"  class="nav-link">Upcoming</a>
          <a href="/about" class={`nav-link${onAbout ? ' nav-link-active' : ''}`} aria-current={onAbout ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>

    <main style="max-width:860px;margin:0 auto;padding:2.5rem 1.25rem 5rem;">
      <slot />
    </main>

    <footer
      style="border-top:1px solid var(--color-border);padding:2rem 1.25rem;font-size:0.75rem;color:var(--color-muted);"
    >
      <div
        style="max-width:860px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:1rem;"
      >
        <div>
          <div style="font-family:var(--font-display);font-size:0.85rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-text);margin-bottom:0.3rem;">
            WC2026 Prediction Tracker
          </div>
          <div>A project by Javier &nbsp;&middot;&nbsp; Isle of Man</div>
        </div>

        <div style="text-align:right;">
          <div style="margin-bottom:0.3rem;">
            Predictions by <span style="color:var(--color-text);">Claude AI</span> &mdash; Opus, Max Effort
          </div>
          <div style="margin-bottom:0.3rem;">
            Site by <span style="color:var(--color-text);">Claude Code</span> &mdash; Sonnet 4.6
          </div>
          <div>Updated {buildTime}</div>
        </div>
      </div>
    </footer>
  </body>
</html>
