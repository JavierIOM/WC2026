---
import Layout from '../layouts/Layout.astro';
import MatchCard from '../components/MatchCard.astro';
import MethodPanel from '../components/MethodPanel.astro';
import { matches, computeStats, isPlayed, formatDate } from '../data/predictions';

const stats = computeStats(matches);

// Rolling window: show played matches from yesterday onward, archive the rest
const today = new Date();
today.setHours(0, 0, 0, 0);
const yesterday = new Date(today);
yesterday.setDate(today.getDate() - 1);

const isRecent = (m: typeof matches[0]) =>
  isPlayed(m) && new Date(m.dateISO) >= yesterday;

const formalMatches = matches.filter(m => !m.informalOnly);
const recentPlayed  = formalMatches.filter(isRecent);
const archivedCount = formalMatches.filter(m => isPlayed(m) && !isRecent(m)).length;

// Group recent played matches by calendar date (not matchday number — MD2 spans many days)
const recentDates = [...new Set(recentPlayed.map(m => m.dateISO))].sort();
const matchdayGroups = recentDates.map(date => ({
  date,
  matches: recentPlayed
    .filter(m => m.dateISO === date)
    .sort((a, b) => a.kickoffBST.localeCompare(b.kickoffBST)),
}));

// All pending (unplayed) matches — client-side JS buckets into upcoming vs live/awaiting
const pendingMatches = formalMatches
  .filter(m => !isPlayed(m))
  .sort((a, b) => {
    const dc = a.dateISO.localeCompare(b.dateISO);
    return dc !== 0 ? dc : a.kickoffBST.localeCompare(b.kickoffBST);
  });

// Returns kickoff as UTC milliseconds for embedding in data attribute
const kickoffUTCms = (m: typeof matches[0]): number => {
  const [y, mo, d] = m.dateISO.split('-').map(Number);
  const [h, mi] = m.kickoffBST.split(':').map(Number);
  return Date.UTC(y, mo - 1, d, h - 1, mi); // BST = UTC+1
};
---

<Layout>

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section id="outright" style="margin-bottom:3rem;">

    <!-- Banner image -->
    <div
      style="position:relative;width:calc(100% + 2.5rem);margin-left:-1.25rem;height:clamp(280px,50vw,480px);overflow:hidden;margin-bottom:2rem;"
    >
      <img
        src="/hero.png"
        alt="World Cup 2026 official branding"
        width="1600"
        height="640"
        fetchpriority="high"
        decoding="async"
        style="width:100%;height:100%;object-fit:cover;object-position:center center;display:block;"
      />
      <!-- Gradient overlay so text below is readable if we ever overlap -->
      <div
        style="position:absolute;inset:0;background:linear-gradient(to top,rgb(5 5 15/0.7) 0%,transparent 50%);"
      ></div>
    </div>

    <p class="section-label" style="margin-bottom:0.75rem;">Outright call</p>

    <div style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:2rem;margin-bottom:2rem;">
      <div>
        <h1
          style="font-family:var(--font-display);font-size:clamp(3rem,8vw,5rem);font-weight:800;letter-spacing:0.01em;line-height:0.95;color:var(--color-text);margin-bottom:0.6rem;"
        >
          Fifa World Cup 2026 Prediction Engine
        </h1>
        <div
          style="display:inline-flex;flex-direction:column;gap:0.4rem;margin-top:0.75rem;background-color:rgb(251 191 36/0.08);border:1px solid rgb(251 191 36/0.35);border-radius:8px;padding:1rem 1.4rem;"
        >
          <span style="font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;letter-spacing:0.02em;color:#fbbf24;line-height:1.1;">
            Final: Spain 1-0 France (or extra time)
          </span>
          <span style="font-size:0.82rem;color:rgb(251 191 36/0.7);letter-spacing:0.04em;">
            MetLife Stadium &nbsp;·&nbsp; 19 July 2026 &nbsp;·&nbsp; Golden Ball: Lamine Yamal
          </span>
        </div>
      </div>

      <!-- Live accuracy block -->
      {stats.resultTotal > 0 && (
        <div
          style="display:flex;gap:1.5rem;flex-wrap:wrap;"
        >
          <div style="text-align:center;">
            <div style="font-family:var(--font-display);font-size:2.75rem;font-weight:800;color:var(--color-correct);line-height:1;">
              {stats.resultCorrect}<span style="font-size:1.5rem;color:var(--color-muted);">/{stats.resultTotal}</span>
            </div>
            <div style="font-size:0.7rem;color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Results</div>
          </div>
          <div style="text-align:center;">
            <div style="font-family:var(--font-display);font-size:2.75rem;font-weight:800;color:var(--color-exact);line-height:1;">
              {stats.resultExact}
            </div>
            <div style="font-size:0.7rem;color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Exact</div>
          </div>
          <div style="text-align:center;">
            <div style="font-family:var(--font-display);font-size:2.75rem;font-weight:800;color:var(--color-accent);line-height:1;">
              {stats.scorerPositive}<span style="font-size:1.5rem;color:var(--color-muted);">/{stats.scorerTotal}</span>
            </div>
            <div style="font-size:0.7rem;color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Scorers</div>
          </div>
        </div>
      )}
    </div>

    <!-- Outright reasoning -->
    <div
      style="background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.1rem 1.25rem;font-size:0.85rem;line-height:1.7;color:var(--color-text);opacity:0.85;"
    >
      <p class="section-label" style="margin-bottom:0.6rem;">Why?</p>
      <p style="margin-bottom:0.6rem;">
        European champions with the best midfield in the tournament. Possession game suits the
        North American summer heat and the 104-match slog of the expanded format.
        ~+450 favourite at the outset.
      </p>
      <p style="margin-bottom:0.4rem;"><strong style="color:var(--color-text);">Threats:</strong></p>
      <ul style="margin:0 0 0.6rem 0;padding-left:1.1rem;display:flex;flex-direction:column;gap:0.25rem;">
        <li>France, with Mbappe chasing the all-time World Cup scoring record.</li>
        <li>England for squad depth.</li>
        <li>Dark horse: Portugal. Back them to top Group K and reach the quarter-final, but do not back them further until they win something ugly.</li>
      </ul>
      <p style="margin:0;color:var(--color-muted);">
        Final revised from 2-1 to 1-0/ET as the tournament has confirmed that elite knockout matchups
        tighten at the back.
      </p>
    </div>
  </section>

  <!-- ── METHOD ────────────────────────────────────────────────────────────── -->
  <section id="method" style="margin-bottom:3rem;" aria-labelledby="method-h">
    <h2 id="method-h" class="section-label" style="margin:0 0 0.75rem;">Prediction method</h2>
    <MethodPanel />
  </section>

  <!-- ── MATCHDAYS ─────────────────────────────────────────────────────────── -->
  <section id="matchdays" style="margin-bottom:3rem;" aria-labelledby="matchdays-h">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;">
      <h2 id="matchdays-h" class="section-label" style="margin:0;">Recent results</h2>
      {archivedCount > 0 && (
        <a
          href="/archive"
          style="font-size:0.75rem;font-weight:600;color:var(--color-accent);text-decoration:none;letter-spacing:0.04em;white-space:nowrap;"
        >
          Archive ({archivedCount} matches) &rsaquo;
        </a>
      )}
    </div>

    {matchdayGroups.length === 0 ? (
      <p style="font-size:0.85rem;color:var(--color-muted);">
        No results in the last 24 hours.
        {archivedCount > 0 && (
          <a href="/archive" style="color:var(--color-accent);text-decoration:none;">View all past results &rsaquo;</a>
        )}
      </p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:2.5rem;">
        {matchdayGroups.map(({ date, matches: dateMatches }) => (
          <div>
            <h3
              style="font-family:var(--font-display);font-size:1.05rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-muted);margin:0 0 0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--color-border);"
            >
              {formatDate(date)}
            </h3>
            <div style="display:flex;flex-direction:column;gap:0.75rem;">
              {dateMatches.map(match => (
                <MatchCard match={match} />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- ── UPCOMING / LIVE AWAITING ─────────────────────────────────────────── -->
  <section id="upcoming" aria-labelledby="upcoming-h">
    <h2 id="upcoming-h" class="section-label" style="margin:0 0 0.35rem;">Upcoming calls</h2>
    <p style="font-size:0.75rem;color:var(--color-muted);margin:0 0 0.75rem;line-height:1.5;">
      Predictions are added 2-3 days before kickoff. Fixtures further out are listed as scheduled only and will be predicted closer to the time.
    </p>
    <p id="predictions-due-count" style="font-size:0.75rem;font-weight:600;color:#f59e0b;margin:0 0 0.75rem;display:none;"></p>
    <div id="upcoming-list" style="display:flex;flex-direction:column;gap:0.75rem;">
      {pendingMatches.map(m => (
        <div data-pending-match="" data-kickoff-utc={kickoffUTCms(m).toString()}>
          <MatchCard match={m} />
        </div>
      ))}
    </div>
    <p id="no-upcoming-msg" style="font-size:0.85rem;color:var(--color-muted);display:none;">No upcoming matches.</p>
  </section>

  <section id="live-awaiting-section" style="margin-top:2rem;padding-top:2rem;border-top:1px solid var(--color-border);display:none;" aria-label="Live or awaiting result">
    <h2 class="section-label" style="margin:0 0 0.35rem;">Live / Awaiting result</h2>
    <p style="font-size:0.75rem;color:var(--color-muted);margin:0 0 0.75rem;">
      These matches have started or finished but results have not yet been logged.
    </p>
    <div id="live-awaiting-list" style="display:flex;flex-direction:column;gap:0.75rem;"></div>
  </section>

  <script>
    (function () {
      const BADGE_DUE  = '<span style="display:inline-block;padding:1px 6px;border-radius:4px;font-size:0.65rem;font-weight:700;letter-spacing:0.06em;background:rgb(245 158 11/0.15);color:#f59e0b;border:1px solid rgb(245 158 11/0.35);">PREDICTION DUE</span>';
      const BADGE_MISS = '<span style="display:inline-block;padding:1px 6px;border-radius:4px;font-size:0.65rem;font-weight:700;letter-spacing:0.06em;background:rgb(239 68 68/0.15);color:#ef4444;border:1px solid rgb(239 68 68/0.35);">NO CALL LOGGED</span>';

      function bucketMatches() {
        const now = Date.now();
        const upcomingList  = document.getElementById('upcoming-list');
        const liveSection   = document.getElementById('live-awaiting-section');
        const liveList      = document.getElementById('live-awaiting-list');
        const noUpcomingMsg = document.getElementById('no-upcoming-msg');
        const dueCountEl    = document.getElementById('predictions-due-count');
        if (!upcomingList || !liveSection || !liveList) return;

        // Collect past-kickoff cards
        const liveCards = [];
        upcomingList.querySelectorAll('[data-pending-match]').forEach(card => {
          const kickoff = parseInt(card.getAttribute('data-kickoff-utc') || '0', 10);
          if (kickoff > 0 && kickoff <= now) liveCards.push(card);
        });

        // Move to live section (most recent first); flag unpredicted as NO CALL
        for (let i = liveCards.length - 1; i >= 0; i--) {
          const ph = liveCards[i].querySelector('.prediction-placeholder');
          if (ph) ph.innerHTML = BADGE_MISS;
          liveList.appendChild(liveCards[i]);
        }

        if (liveCards.length > 0) liveSection.style.display = '';

        if (upcomingList.querySelectorAll('[data-pending-match]').length === 0 && noUpcomingMsg) {
          upcomingList.style.display = 'none';
          noUpcomingMsg.style.display = '';
        }

        // Flag upcoming unpredicted matches within 72h
        let dueCount = 0;
        upcomingList.querySelectorAll('[data-pending-match]').forEach(wrapper => {
          const kickoff = parseInt(wrapper.getAttribute('data-kickoff-utc') || '0', 10);
          const ph = wrapper.querySelector('.prediction-placeholder');
          if (!ph || !kickoff) return;
          if ((kickoff - now) / 3_600_000 <= 72) {
            ph.innerHTML = BADGE_DUE;
            dueCount++;
          }
        });

        if (dueCountEl) {
          if (dueCount > 0) {
            dueCountEl.textContent = `${dueCount} prediction${dueCount === 1 ? '' : 's'} due in next 72h`;
            dueCountEl.style.display = '';
          } else {
            dueCountEl.style.display = 'none';
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bucketMatches);
      } else {
        bucketMatches();
      }
    })();
  </script>

</Layout>
