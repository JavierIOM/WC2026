---
import Layout from '../layouts/Layout.astro';
import MethodPanel from '../components/MethodPanel.astro';
import { matches, computeStats } from '../data/predictions';

const stats = computeStats(matches);
---

<Layout>

  <!-- ── HERO: SPAIN, WORLD CHAMPIONS ─────────────────────────────────────── -->
  <section id="outright" style="margin-bottom:var(--space-7);">

    <!-- Huge Spanish flag banner — pure graphic device, angled bottom edge -->
    <div
      style="width:calc(100% + 2.5rem);margin-left:-1.25rem;height:clamp(240px,38vw,440px);display:flex;flex-direction:column;margin-bottom:var(--space-6);clip-path:polygon(0 0, 100% 0, 100% 90%, 0 100%);"
    >
      <div style="flex:1;background:#AA151B;"></div>
      <div style="flex:2;background:#F1BF00;"></div>
      <div style="flex:1;background:#AA151B;"></div>
    </div>

    <!-- Asymmetric split: headline/call left-heavy, stat trio offset right -->
    <div
      style="display:grid;grid-template-columns:1.4fr 1fr;gap:var(--space-6);align-items:start;margin-bottom:var(--space-6);"
      class="hero-split"
    >
      <div data-reveal>
        <h1
          style="font-family:var(--font-display);font-size:var(--text-2xl);font-weight:800;letter-spacing:0.01em;line-height:1.05;color:var(--color-text);margin-bottom:var(--space-3);"
        >
          Spain beat Argentina <span style="white-space:nowrap;">1-0 (AET)</span>
        </h1>
        <div
          style="display:inline-flex;flex-direction:column;gap:0.4rem;background-color:rgb(34 197 94/0.08);border:1px solid rgb(34 197 94/0.35);border-radius:var(--radius-card);padding:1rem 1.4rem;"
        >
          <span style="font-family:var(--font-display);font-size:var(--text-lg);font-weight:800;letter-spacing:0.02em;color:#22c55e;line-height:1.1;">
            ✓ Outright call: CORRECT
          </span>
          <span style="font-size:var(--text-xs);color:rgb(34 197 94/0.8);letter-spacing:0.04em;">
            Ferran Torres 106' · MetLife Stadium<br />
            Unbeaten in 38 · Golden Boot: Mbappé (10)
          </span>
        </div>
      </div>

      {stats.resultTotal > 0 && (
        <div class="hero-stats" data-reveal style="display:flex;gap:var(--space-5);flex-wrap:wrap;margin-top:var(--space-5);--reveal-delay:0.08s;">
          <div style="text-align:center;">
            <div class="stat-number" style="font-size:2.75rem;font-weight:800;color:var(--color-correct);line-height:1;">
              {stats.resultCorrect}<span style="font-size:1.5rem;color:var(--color-muted);">/{stats.resultTotal}</span>
            </div>
            <div style="font-size:var(--text-2xs);color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Results</div>
          </div>
          <div style="text-align:center;">
            <div class="stat-number" style="font-size:2.75rem;font-weight:800;color:var(--color-exact);line-height:1;">
              {stats.resultExact}
            </div>
            <div style="font-size:var(--text-2xs);color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Exact</div>
          </div>
          <div style="text-align:center;">
            <div class="stat-number" style="font-size:2.75rem;font-weight:800;color:var(--color-accent);line-height:1;">
              {stats.scorerPositive}<span style="font-size:1.5rem;color:var(--color-muted);">/{stats.scorerTotal}</span>
            </div>
            <div style="font-size:var(--text-2xs);color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Scorers</div>
          </div>
        </div>
      )}
    </div>

    <!-- Recap -->
    <div
      data-reveal
      style="--reveal-delay:0.14s;background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-card);padding:1.1rem 1.25rem;font-size:var(--text-sm);line-height:1.7;color:var(--color-text);opacity:0.85;max-width:65ch;"
    >
      <p style="margin:0;">
        Spain were backed to win the tournament before a ball was kicked, at ~+450. European
        champions, best midfield in the field, a possession game built for the North American
        summer heat and the 104-match slog of the expanded format. They went unbeaten across
        38 matches, kept 7 clean sheets, and won the Final 1-0 after extra time. Ferran Torres
        converted a Nico Williams cutback in the second period of ET, a minute after Williams
        himself had a goal ruled out. Emi Martínez made a World-Cup-final-record 10 saves for
        Argentina, who finished with 10 men after Enzo Fernández's 90+3' red card. Second star,
        exactly like 2010.
      </p>
    </div>
  </section>

  <!-- ── METHOD ────────────────────────────────────────────────────────────── -->
  <section id="method" data-reveal style="--reveal-delay:0.06s;margin-bottom:var(--space-7);" aria-labelledby="method-h">
    <h2 id="method-h" class="section-label" style="margin:0 0 0.75rem;">Prediction method</h2>
    <MethodPanel />
  </section>

  <!-- ── FULL RECORD ───────────────────────────────────────────────────────── -->
  <section style="text-align:center;padding:var(--space-5) 0;">
    <a
      href="/archive"
      style="display:inline-block;margin:0 0.75rem 0.75rem;font-size:var(--text-base);font-weight:600;color:var(--color-accent);text-decoration:none;letter-spacing:0.02em;"
    >
      View full match archive ({matches.filter(m => !m.informalOnly).length} matches) &rsaquo;
    </a>
    <a
      href="/dashboard"
      style="display:inline-block;margin:0 0.75rem 0.75rem;font-size:var(--text-base);font-weight:600;color:var(--color-accent);text-decoration:none;letter-spacing:0.02em;"
    >
      Accuracy dashboard &rsaquo;
    </a>
  </section>

  <style>
    /* Asymmetric split collapses to a single column on narrow viewports */
    @media (max-width: 768px) {
      .hero-split {
        grid-template-columns: 1fr !important;
      }
      .hero-stats {
        margin-top: 0 !important;
        justify-content: flex-start;
      }
    }
  </style>

</Layout>
