---
import Layout from '../layouts/Layout.astro';
import LiveMatches from '../components/LiveMatches.astro';
import { matches, computeStats, getResultVerdict, isPlayed } from '../data/predictions';

// ── Calibration ──────────────────────────────────────────────────────────────
const CAL_BANDS = [
  { min: 40, max: 54, label: '40-54%' },
  { min: 55, max: 64, label: '55-64%' },
  { min: 65, max: 74, label: '65-74%' },
  { min: 75, max: 100, label: '75%+' },
];

const formalPlayed = matches.filter(m => !m.informalOnly && isPlayed(m) && m.confidence !== undefined);

const calibration = CAL_BANDS.map(band => {
  const inBand = formalPlayed.filter(m => m.confidence! >= band.min && m.confidence! <= band.max);
  const correct = inBand.filter(m => { const v = getResultVerdict(m); return v === 'EXACT' || v === 'CORRECT'; });
  const avgConf = inBand.length > 0
    ? Math.round(inBand.reduce((s, m) => s + m.confidence!, 0) / inBand.length)
    : Math.round((band.min + band.max) / 2);
  return {
    label: band.label,
    count: inBand.length,
    predicted: avgConf,
    actual: inBand.length > 0 ? Math.round((correct.length / inBand.length) * 100) : null,
  };
});

// SVG reliability plot dimensions
const calPadL = 44; const calPadT = 16; const calPadR = 20; const calPadB = 36;
const calPlotW = 240; const calPlotH = 200;
const calSvgW = calPadL + calPlotW + calPadR;
const calSvgH = calPadT + calPlotH + calPadB;

function calX(pct: number) { return calPadL + (pct / 100) * calPlotW; }
function calY(pct: number) { return calPadT + calPlotH - (pct / 100) * calPlotH; }

const stats = computeStats(matches);

const allMatchdays = [...new Set(matches.filter(m => !m.informalOnly).map(m => m.matchday))].sort((a, b) => a - b);

interface BarDatum {
  md: number;
  total: number;
  correct: number;
  pct: number | null;
}

const barData: BarDatum[] = allMatchdays.map(md => {
  const d = stats.resultsByMatchday[md];
  if (!d || d.total === 0) return { md, total: 0, correct: 0, pct: null };
  return { md, total: d.total, correct: d.correct, pct: d.correct / d.total };
});

const svgW   = 700;
const svgH   = 180;
const padL   = 40;
const padB   = 42;
const barW   = 56;
const barGap = 20;
const chartH = svgH - padB;

function barX(i: number) {
  const totalW = barData.length * (barW + barGap) - barGap;
  const startX = padL + (svgW - padL - totalW) / 2;
  return startX + i * (barW + barGap);
}

function barColor(pct: number): string {
  if (pct >= 0.67) return '#22c55e';
  if (pct >= 0.34) return '#f59e0b';
  return '#ef4444';
}

const resultPct = stats.resultTotal > 0
  ? Math.round((stats.resultCorrect / stats.resultTotal) * 100) : 0;
const scorerPct = stats.scorerTotal > 0
  ? Math.round((stats.scorerPositive / stats.scorerTotal) * 100) : 0;
---

<Layout
  title="Dashboard | WC2026 Prediction Tracker"
  description="Accuracy dashboard for the WC2026 AI prediction engine. Results, exact scorelines, scorer calls, and per-matchday breakdown."
>
  <section style="padding-top:2.5rem;">

    <!-- Live matches -->
    <LiveMatches />

    <p class="section-label" style="margin-bottom:0.75rem;">Accuracy dashboard</p>

    <h1
      style="font-family:var(--font-display);font-size:clamp(2.5rem,7vw,4rem);font-weight:800;letter-spacing:0.01em;text-transform:uppercase;line-height:0.95;color:var(--color-text);margin-bottom:2rem;"
    >
      How accurate<br />is the engine?
    </h1>

    <!-- Stat cards: fixed 3-column grid so they are always equal width and height -->
    <div
      style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1.5rem;"
    >

      <!-- Results -->
      <div style="background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.25rem 1.5rem;display:flex;flex-direction:column;gap:0.25rem;">
        <p class="section-label">Results</p>
        <div style="display:flex;align-items:baseline;gap:0.35rem;margin-top:0.25rem;">
          <span style="font-family:var(--font-display);font-size:3.5rem;font-weight:800;line-height:1;color:var(--color-correct);">{stats.resultCorrect}</span>
          <span style="font-family:var(--font-display);font-size:1.75rem;font-weight:700;color:var(--color-muted);">/ {stats.resultTotal}</span>
        </div>
        <p style="font-size:0.72rem;color:var(--color-muted);margin-top:0.1rem;">{resultPct}% correct</p>
      </div>

      <!-- Exact scorelines -->
      <div style="background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.25rem 1.5rem;display:flex;flex-direction:column;gap:0.25rem;">
        <p class="section-label">Exact scorelines</p>
        <div style="display:flex;align-items:baseline;gap:0.35rem;margin-top:0.25rem;">
          <span style="font-family:var(--font-display);font-size:3.5rem;font-weight:800;line-height:1;color:var(--color-exact);">{stats.resultExact}</span>
          <span style="font-family:var(--font-display);font-size:1.75rem;font-weight:700;color:var(--color-muted);">/ {stats.resultTotal}</span>
        </div>
        <p style="font-size:0.72rem;color:var(--color-muted);margin-top:0.1rem;">Bang on the scoreline</p>
      </div>

      <!-- Scorer calls -->
      <div style="background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.25rem 1.5rem;display:flex;flex-direction:column;gap:0.25rem;">
        <p class="section-label">Scorer calls</p>
        <div style="display:flex;align-items:baseline;gap:0.35rem;margin-top:0.25rem;">
          <span style="font-family:var(--font-display);font-size:3.5rem;font-weight:800;line-height:1;color:var(--color-accent);">{stats.scorerPositive}</span>
          <span style="font-family:var(--font-display);font-size:1.75rem;font-weight:700;color:var(--color-muted);">/ {stats.scorerTotal}</span>
        </div>
        <p style="font-size:0.72rem;color:var(--color-muted);margin-top:0.1rem;">{scorerPct}% hit or assist</p>
      </div>

    </div>

    <!-- Bar chart -->
    <div style="background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.25rem 1.5rem;">
      <p class="section-label" style="margin-bottom:1rem;">Result accuracy by matchday</p>

      {barData.every(d => d.pct === null) ? (
        <p style="font-size:0.82rem;color:var(--color-muted);padding:1rem 0;">No played matches yet.</p>
      ) : (
        <svg
          viewBox={`0 0 ${svgW} ${svgH}`}
          style="width:100%;height:auto;overflow:visible;"
          role="img"
          aria-label="Bar chart of result accuracy by matchday"
        >
          {[0, 25, 50, 75, 100].map(pct => {
            const y = chartH - (pct / 100) * chartH;
            return (
              <>
                <line x1={padL} y1={y} x2={svgW} y2={y} stroke="#1e1e38" stroke-width="1" />
                <text x={padL - 6} y={y + 4} text-anchor="end" font-size="10" fill="#6868a0">{pct}%</text>
              </>
            );
          })}

          {barData.map((d, i) => {
            const x = barX(i);
            const labelY = svgH - 6;

            if (d.pct === null) {
              return (
                <>
                  <rect x={x} y={4} width={barW} height={chartH - 4} fill="rgb(30 30 56 / 0.5)" rx="3" />
                  <text x={x + barW / 2} y={chartH / 2 + 4} text-anchor="middle" font-size="10" fill="#4b5563">TBD</text>
                  <text x={x + barW / 2} y={labelY} text-anchor="middle" font-size="11" fill="#6868a0">MD{d.md}</text>
                </>
              );
            }

            const bH    = Math.max(4, d.pct * chartH);
            const bY    = chartH - bH;
            const color = barColor(d.pct);
            const pctLabel = Math.round(d.pct * 100);

            return (
              <>
                <rect x={x} y={bY} width={barW} height={bH} fill={color} rx="3" fill-opacity="0.85" />
                <text
                  x={x + barW / 2}
                  y={bY > 18 ? bY - 5 : bY + 14}
                  text-anchor="middle"
                  font-size="12"
                  font-weight="700"
                  fill={color}
                >{pctLabel}%</text>
                <text x={x + barW / 2} y={labelY - 14} text-anchor="middle" font-size="9" fill="#4a4a6a">{d.correct}/{d.total}</text>
                <text x={x + barW / 2} y={labelY} text-anchor="middle" font-size="11" fill="#6868a0">MD{d.md}</text>
              </>
            );
          })}
        </svg>
      )}

      <div style="display:flex;gap:1.5rem;margin-top:0.75rem;flex-wrap:wrap;">
        {[
          { color: '#22c55e', label: '67%+ (on track)' },
          { color: '#f59e0b', label: '34-66% (mixed)' },
          { color: '#ef4444', label: '0-33% (poor)' },
        ].map(({ color, label }) => (
          <div style="display:flex;align-items:center;gap:0.4rem;font-size:0.71rem;color:var(--color-muted);">
            <span style={`display:inline-block;width:10px;height:10px;border-radius:2px;background-color:${color};`}></span>
            {label}
          </div>
        ))}
      </div>
    </div>

    <!-- Calibration -->
    <div style="background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1.25rem 1.5rem;margin-top:1.5rem;">
      <p class="section-label" style="margin-bottom:0.25rem;">Confidence calibration</p>
      <p style="font-size:0.75rem;color:var(--color-muted);margin-bottom:1.25rem;">Predicted confidence vs actual hit rate. Dots above the diagonal = overconfident; below = underconfident.</p>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start;">

        <!-- Reliability plot -->
        <svg
          viewBox={`0 0 ${calSvgW} ${calSvgH}`}
          style="width:100%;height:auto;overflow:visible;"
          role="img"
          aria-label="Reliability plot: predicted confidence vs actual hit rate"
        >
          <!-- Grid lines -->
          {[0, 25, 50, 75, 100].map(pct => (
            <>
              <line x1={calPadL} y1={calY(pct)} x2={calPadL + calPlotW} y2={calY(pct)} stroke="#1e1e38" stroke-width="1" />
              <text x={calPadL - 6} y={calY(pct) + 4} text-anchor="end" font-size="9" fill="#6868a0">{pct}%</text>
            </>
          ))}
          {[0, 25, 50, 75, 100].map(pct => (
            <text x={calX(pct)} y={calPadT + calPlotH + 18} text-anchor="middle" font-size="9" fill="#6868a0">{pct}%</text>
          ))}

          <!-- Axis labels -->
          <text x={calPadL + calPlotW / 2} y={calSvgH - 2} text-anchor="middle" font-size="9" fill="#4a4a6a">Predicted confidence</text>
          <text
            x={10}
            y={calPadT + calPlotH / 2}
            text-anchor="middle"
            font-size="9"
            fill="#4a4a6a"
            transform={`rotate(-90, 10, ${calPadT + calPlotH / 2})`}
          >Actual hit rate</text>

          <!-- Perfect calibration diagonal -->
          <line
            x1={calX(0)} y1={calY(0)}
            x2={calX(100)} y2={calY(100)}
            stroke="#3a3a5a"
            stroke-width="1"
            stroke-dasharray="4 3"
          />

          <!-- Data points -->
          {calibration.filter(b => b.count > 0 && b.actual !== null).map(b => {
            const cx = calX(b.predicted);
            const cy = calY(b.actual!);
            const r  = Math.min(18, 8 + b.count * 2.5);
            const isAbove = b.actual! >= b.predicted;
            const dotColor = isAbove ? '#22c55e' : '#ef4444';
            return (
              <>
                <circle cx={cx} cy={cy} r={r} fill={dotColor} fill-opacity="0.18" stroke={dotColor} stroke-width="1.5" />
                <text x={cx} y={cy + 4} text-anchor="middle" font-size="10" font-weight="700" fill={dotColor}>{b.actual}%</text>
                <text x={cx} y={cy - r - 4} text-anchor="middle" font-size="8" fill="#6868a0">{b.label}</text>
              </>
            );
          })}

          {calibration.every(b => b.count === 0) && (
            <text x={calPadL + calPlotW / 2} y={calPadT + calPlotH / 2} text-anchor="middle" font-size="11" fill="#4b5563">No data yet</text>
          )}
        </svg>

        <!-- Table -->
        <table style="width:100%;border-collapse:collapse;font-size:0.78rem;">
          <thead>
            <tr>
              {['Band', 'Predicted', 'Actual', 'n'].map(h => (
                <th style="text-align:left;padding:0.3rem 0.5rem;color:var(--color-muted);font-size:0.68rem;letter-spacing:0.07em;text-transform:uppercase;border-bottom:1px solid var(--color-border);">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {calibration.map((b, i) => (
              <tr style={i > 0 ? 'border-top:1px solid var(--color-border);' : ''}>
                <td style="padding:0.4rem 0.5rem;color:var(--color-muted);">{b.label}</td>
                <td style="padding:0.4rem 0.5rem;color:var(--color-text);">{b.predicted}%</td>
                <td style={`padding:0.4rem 0.5rem;font-weight:600;color:${b.actual === null ? 'var(--color-muted)' : b.actual >= b.predicted ? '#22c55e' : '#ef4444'};`}>
                  {b.actual === null ? '--' : `${b.actual}%`}
                </td>
                <td style="padding:0.4rem 0.5rem;color:var(--color-muted);">{b.count}</td>
              </tr>
            ))}
          </tbody>
        </table>

      </div>
    </div>

  </section>
</Layout>
