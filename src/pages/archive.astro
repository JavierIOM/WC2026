---
import Layout from '../layouts/Layout.astro';
import MatchCard from '../components/MatchCard.astro';
import { matches, isPlayed, computeStats } from '../data/predictions';

// Tournament complete — every match lives in the archive now.
const formalMatches = matches.filter(m => !m.informalOnly);

// Knockout rounds, in bracket order
const ROUND_ORDER = ['R32', 'R16', 'QF', 'SF', '3RD', 'F'];
const ROUND_NAMES: Record<string, string> = {
  R32: 'Round of 32', R16: 'Round of 16', QF: 'Quarter-finals',
  SF: 'Semi-finals', '3RD': 'Third-place playoff', F: 'Final',
};
const knockoutMatches = formalMatches.filter(m => m.round && ROUND_ORDER.includes(m.round));
const knockoutRounds = ROUND_ORDER
  .map(round => ({
    round,
    matches: knockoutMatches
      .filter(m => m.round === round)
      .sort((a, b) => a.dateISO.localeCompare(b.dateISO) || a.kickoffBST.localeCompare(b.kickoffBST)),
  }))
  .filter(r => r.matches.length > 0);

// Group stage: matchday 1-3, grouped by group letter
const groupStageMatches = formalMatches.filter(m => isPlayed(m) && m.matchday <= 3);
const groupLetters = [...new Set(
  groupStageMatches.map(m => m.group ?? '').filter(Boolean)
)].sort();
const groupData = groupLetters.map(grp => ({
  grp,
  matches: groupStageMatches
    .filter(m => m.group === grp)
    .sort((a, b) => a.dateISO.localeCompare(b.dateISO) || a.kickoffBST.localeCompare(b.kickoffBST)),
}));

const stats = computeStats(matches);
---

<Layout
  title="Full Match Archive | WC2026 Prediction Tracker"
  description="Every WC2026 prediction and result — knockout rounds and group stage, in full."
>

  <section style="padding-top:2rem;">

    <p class="section-label" style="margin-bottom:0.75rem;">Archive</p>
    <h1
      style="font-family:var(--font-display);font-size:clamp(2.2rem,6vw,3.5rem);font-weight:800;letter-spacing:0.01em;text-transform:uppercase;line-height:0.95;color:var(--color-text);margin-bottom:0.5rem;"
    >
      Full Match Archive
    </h1>
    <p style="font-size:0.85rem;color:var(--color-muted);margin-bottom:1.25rem;">
      All {formalMatches.length} predictions and results, from Group A to the Final.
      Tournament summary on the <a href="/" style="color:var(--color-accent);text-decoration:none;">main page</a>.
    </p>

    <!-- Full tournament tally -->
    {stats.resultTotal > 0 && (
      <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-bottom:2.5rem;padding:1rem 1.25rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;">
        <div style="text-align:center;">
          <div style="font-family:var(--font-display);font-size:2rem;font-weight:800;color:var(--color-correct);line-height:1;">
            {stats.resultCorrect}<span style="font-size:1.1rem;color:var(--color-muted);">/{stats.resultTotal}</span>
          </div>
          <div style="font-size:0.7rem;color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Results</div>
        </div>
        <div style="text-align:center;">
          <div style="font-family:var(--font-display);font-size:2rem;font-weight:800;color:var(--color-exact);line-height:1;">
            {stats.resultExact}
          </div>
          <div style="font-size:0.7rem;color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Exact</div>
        </div>
        <div style="text-align:center;">
          <div style="font-family:var(--font-display);font-size:2rem;font-weight:800;color:var(--color-accent);line-height:1;">
            {stats.scorerPositive}<span style="font-size:1.1rem;color:var(--color-muted);">/{stats.scorerTotal}</span>
          </div>
          <div style="font-size:0.7rem;color:var(--color-muted);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;">Scorers</div>
        </div>
      </div>
    )}

    <!-- Knockout rounds -->
    {knockoutRounds.length > 0 && (
      <div style="display:flex;flex-direction:column;gap:2.5rem;margin-bottom:3rem;">
        {knockoutRounds.map(({ round, matches: roundMatches }) => (
          <div>
            <h2
              style="font-family:var(--font-display);font-size:1.05rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-muted);margin:0 0 0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--color-border);"
            >
              {ROUND_NAMES[round] ?? round}
            </h2>
            <div style="display:flex;flex-direction:column;gap:0.75rem;">
              {roundMatches.map(match => (
                <MatchCard match={match} />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Group stage -->
    <h2 class="section-label" style="margin:0 0 1rem;">Group stage</h2>
    {groupData.length === 0 ? (
      <p style="font-size:0.85rem;color:var(--color-muted);">No group stage matches logged.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:2.5rem;">
        {groupData.map(({ grp, matches: grpMatches }) => (
          <div>
            <h3
              style="font-family:var(--font-display);font-size:1.05rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-muted);margin:0 0 0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--color-border);"
            >
              Group {grp}
            </h3>
            <div style="display:flex;flex-direction:column;gap:0.75rem;">
              {grpMatches.map(match => (
                <MatchCard match={match} />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

  </section>

</Layout>
